# ---------------------------------------------------------------------------------------------------
# Free Chatbot Generator - configuration. Copy this file to .env and fill it in. Never commit .env.
# ---------------------------------------------------------------------------------------------------

# PostgreSQL connection string. The default matches `npm run db:dev-up` (docker-compose.dev.yml).
DATABASE_URL="postgresql://fcg:fcg@localhost:5432/fcg?schema=public"

# REQUIRED. Secret that encrypts the AI provider API keys stored in the database (AES-256-GCM).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy somewhere safe: if you lose it, or change it, the saved API keys become unreadable.
APP_SECRET=""

# Public address of this instance, used in the embed snippets and to always allow the admin preview.
# Optional: when empty it is derived from the request. Set it behind a reverse proxy.
APP_URL=""

# Docker Compose only: password of the bundled PostgreSQL, and the port published on the host.
POSTGRES_PASSWORD=""
PORT=3010

# Which header holds the visitor's IP address (rate limiting): none (default), cloudflare or xff.
# Set it ONLY when a reverse proxy of yours overwrites the header: otherwise visitors could forge it.
#   cloudflare = cf-connecting-ip   xff = the last X-Forwarded-For entry
TRUST_PROXY=none

# Optional. When set, creating the first admin account asks for this value, so nobody can claim a fresh public instance.
SETUP_TOKEN=""

# Optional. Delete chat messages older than this many days (empty = keep forever).
RETENTION_DAYS=""

# Allow importing web pages from private networks (localhost, intranet). Off by default (SSRF protection).
ALLOW_PRIVATE_URLS=false

# Rate limits of the public chat API (messages per minute).
CHAT_RATE_PER_MINUTE=15
CHAT_BOT_RATE_PER_MINUTE=300

# Where encrypted copies of the API keys are saved before risky actions (default: ./backups).
KEY_BACKUP_DIR=""
