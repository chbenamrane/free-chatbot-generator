# PostgreSQL connection string (the docker-compose.yml database matches this default).
DATABASE_URL="postgresql://fcg:fcg@localhost:5432/fcg?schema=public"

# Secret that encrypts the AI provider API keys stored in the database.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never change it afterwards (saved keys would become unreadable) and never share it.
APP_SECRET=""
