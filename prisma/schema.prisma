// Database schema: every "model" becomes a PostgreSQL table.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Admin area ----------

// The instance has exactly one admin. "singleton" is always true and unique, so the database itself
// refuses a second row (the first-run setup page cannot be raced).
model Admin {
  id           String         @id @default(cuid())
  singleton    Boolean        @unique @default(true)
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  sessions     AdminSession[]
}

// Only the SHA-256 of the session token is stored, never the token itself.
model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

// Failed sign-in attempts, counted per e-mail and per IP address (brute-force protection).
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String // "email:<address>" or "ip:<address>"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ---------- Chatbots ----------

// One chatbot. The public key (pk_...) identifies it in the widget and is safe to expose in a web page;
// it only works from the allowed origins. The secret key (sk_...) is for server-to-server calls: only its
// SHA-256 hash is stored, the key itself is shown once when generated.
model Bot {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String   @default("")
  publicKey     String   @unique
  secretKeyHash String?  @unique
  secretKeyHint String? // last characters of the secret key, to recognize it in the admin
  allowedOrigins String[] // e.g. "https://example.com"; empty = any origin
  languages     String[] // language codes the bot answers in (see src/lib/languages.ts)
  instructions  String   @default("") // extra system instructions (tone, scope, rules)
  welcomeMessage String  @default("")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  providers     BotProvider[]
}

// An AI provider configured for one chatbot. Providers are tried in "sortOrder"; when one fails (quota, outage,
// rejected key) it is paused for a while ("pausedUntil") and the next one answers. API keys are encrypted
// (AES-256-GCM, see src/lib/crypto/secret-box.ts) so a database dump does not reveal them.
model BotProvider {
  id          String    @id @default(cuid())
  botId       String
  bot         Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  provider    String // gemini | groq | openrouter | cerebras | mistral | openai | anthropic | custom
  enabled     Boolean   @default(true)
  sortOrder   Int       @default(0)
  model       String
  keyEnc      String?
  baseUrl     String? // only for "custom" (any OpenAI-compatible endpoint)
  pausedUntil DateTime?
  lastError   String?
  updatedAt   DateTime  @updatedAt

  @@unique([botId, provider])
  @@index([botId, sortOrder])
}
