// Database schema: every "model" becomes a PostgreSQL table.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Admin area ----------

// The instance has exactly one admin. "singleton" is always true and unique, so the database itself
// refuses a second row (the first-run setup page cannot be raced).
model Admin {
  id           String         @id @default(cuid())
  singleton    Boolean        @unique @default(true)
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  dashboardLatestCount Int    @default(10) // how many latest messages the dashboard shows
  sessions     AdminSession[]
}

// Only the SHA-256 of the session token is stored, never the token itself.
model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

// Failed sign-in attempts, counted per e-mail and per IP address (brute-force protection).
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String // "email:<address>" or "ip:<address>"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ---------- Chatbots ----------

// One chatbot. The public key (pk_...) identifies it in the widget and is safe to expose in a web page;
// it only works from the allowed origins. The secret key (sk_...) is for server-to-server calls: only its
// SHA-256 hash is stored, the key itself is shown once when generated.
model Bot {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String   @default("")
  publicKey     String   @unique
  secretKeyHash String?  @unique
  secretKeyHint String? // last characters of the secret key, to recognize it in the admin
  allowedOrigins String[] // e.g. "https://example.com"; empty = any origin
  languages     String[] // language codes the bot answers in (see src/lib/languages.ts)
  instructions  String   @default("") // extra system instructions (tone, scope, rules)
  welcomeMessage String  @default("")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  knowledgeVersion Int   @default(0) // bumped whenever the knowledge changes (invalidates cached answers)
  appearance    Json     @default("{}") // widget look: colors, position, texts (see src/lib/bots/appearance.ts)
  providers     BotProvider[]
  sources       KnowledgeSource[]
  chatLogs      ChatLog[]
}

// An AI provider configured for one chatbot. Providers are tried in "sortOrder"; when one fails (quota, outage,
// rejected key) it is paused for a while ("pausedUntil") and the next one answers. API keys are encrypted
// (AES-256-GCM, see src/lib/crypto/secret-box.ts) so a database dump does not reveal them.
model BotProvider {
  id          String    @id @default(cuid())
  botId       String
  bot         Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  provider    String // gemini | groq | openrouter | cerebras | mistral | openai | anthropic | custom
  enabled     Boolean   @default(true)
  sortOrder   Int       @default(0)
  model       String
  keyEnc      String?
  baseUrl     String? // only for "custom" (any OpenAI-compatible endpoint)
  pausedUntil DateTime?
  lastError   String?
  updatedAt   DateTime  @updatedAt

  @@unique([botId, provider])
  @@index([botId, sortOrder])
}

// ---------- Knowledge (what a chatbot has learned) ----------

// One piece of knowledge given to a chatbot: pasted text, a Q&A pair, a web page or a file. The original text is kept
// so it can be edited or re-indexed; it is cut into chunks for searching.
model KnowledgeSource {
  id         String           @id @default(cuid())
  botId      String
  bot        Bot              @relation(fields: [botId], references: [id], onDelete: Cascade)
  type       String // text | faq | url | file
  origin     String           @default("admin") // admin | improvement (answer to an unanswered question)
  title      String
  content    String // original text (for faq: the question, a blank line, then the answer)
  url        String?
  chunkCount Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  chunks     KnowledgeChunk[]

  @@index([botId, createdAt])
}

// A searchable piece of a source. "tsv" is a generated full-text column (see the migration): it is never written by the app.
model KnowledgeChunk {
  id       String                   @id @default(cuid())
  sourceId String
  source   KnowledgeSource          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  botId    String
  position Int
  content  String
  tsv      Unsupported("tsvector")?

  @@index([botId])
  @@index([sourceId])
  @@index([tsv], type: Gin)
}

// ---------- Conversations ----------

// One question and its answer. "unanswered": the chatbot did not have the information (it feeds the improvement loop);
// "handled": the admin dealt with it. "visitorHash" is a salted hash of the IP address, never the address itself.
model ChatLog {
  id             String   @id @default(cuid())
  botId          String
  bot            Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  conversationId String?
  createdAt      DateTime @default(now())
  question       String
  answer         String   @default("")
  status         String   @default("ok") // ok | busy (no provider could answer) | error
  provider       String?
  model          String?
  fallback       Boolean  @default(false) // answered by a provider other than the first choice
  cached         Boolean  @default(false) // answer taken from the cache (no AI call)
  unanswered     Boolean  @default(false)
  handled        Boolean  @default(false)
  feedback       Int      @default(0) // 1 helpful, -1 not helpful
  visitorHash    String?
  origin         String?
  latencyMs      Int?

  @@index([botId, createdAt])
  @@index([botId, unanswered, handled])
}

// Answers already given to a first question. "version" changes with the knowledge and settings of the chatbot,
// so an outdated answer is never served.
model ChatCache {
  botId     String
  key       String // hash of the normalized question
  answer    String
  version   String
  hits      Int      @default(0)
  createdAt DateTime @default(now())

  @@id([botId, key])
  @@index([createdAt])
}

// Requests counted for rate limiting (per visitor and per chatbot).
model RateHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
